GROQ_API_KEY=tu_api_key_de_groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

YOU_API_KEY=tu_api_key_de_you
# (tambien se acepta YDC_API_KEY como alias)
# NUEVO: todo You.com pasa por el endpoint /v1/answer (Smart/Answer)
YOU_ANSWER_URL=https://api.you.com/v1/answer
YOU_RESEARCH_EFFORT=deep
YOU_FRESHNESS=day
YOU_SAFESEARCH=strict
YOU_LANGUAGE=ES
YOU_INCLUDE_DOMAINS=sofascore.com,flashscore.com


# Aiven MySQL (SSL requerido)
# Opcion A: variables sueltas
MYSQL_HOST=mysql-xxxxxxx-tuservicio.aivencloud.com
MYSQL_PORT=19392
MYSQL_USER=avnadmin
MYSQL_PASSWORD=tu_password_de_aiven
MYSQL_DATABASE=defaultdb

# Opcion B: URL completa (tiene prioridad sobre las variables sueltas)
# MYSQL_URL=mysql://avnadmin:PASSWORD@host.aivencloud.com:19392/defaultdb?ssl-mode=REQUIRED

# Admin inicial (se crea/actualiza automaticamente al arrancar)
ADMIN_USERNAME=alec
ADMIN_PASSWORD=tu_password_admin
ADMIN_ACCESS_DAYS=1000

FRONTEND_ORIGINS=http://localhost:5173,https://threesixtybets-chat.vercel.app
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium

# 36AI (Groq + tools + odds-api) - segunda IA del ecosistema
AI36_GROQ_API_KEY=tu_api_key_de_groq_para_36ai
AI36_GROQ_MODEL=openai/gpt-oss-120b
AI36_GROQ_FALLBACK=openai/gpt-oss-20b
AI36_ODDS_API_KEY=tu_api_key_de_odds_api_io
AI36_ODDS_URL=https://odds-api.io/api/v1

# ---- MOTORES DEDICADOS (uno por superficie) ----
# Groq aplica los limites POR MODELO: darle a cada superficie su propio modelo
# evita que una oleada de trafico en el chat tumbe el dashboard o las stats.
# Si no defines la *_API_KEY, el modulo reutiliza AI36_GROQ_API_KEY.

# Soporte: modelo pequeno y rapido (respuestas cortas, debe ser instantaneo).
SUPPORT_AI_API_KEY=opcional_otra_cuenta
SUPPORT_AI_MODEL=qwen/qwen3.8-27b
SUPPORT_AI_MODEL_FALLBACK=qwen/qwen3.8-27b

# Dashboard: generacion de picks (ai/dashboard_ia.py).
# Hace BUSQUEDA WEB antes de generar (lesiones, cuotas, forma) e inyecta los
# resultados como contexto. Sin esto el pick se apoya solo en la memoria del
# modelo. Se puede apagar con DASHBOARD_AI_WEB=false si prefieres menos latencia.
DASHBOARD_AI_API_KEY=opcional_otra_cuenta
DASHBOARD_AI_MODEL=openai/gpt-oss-20b
DASHBOARD_AI_FALLBACK=openai/gpt-oss-120b
DASHBOARD_AI_WEB=true

# Estadisticas: analisis corto de partido (ai/stats_ia.py).
# OJO: max_tokens 500 dejaba el content VACIO en los gpt-oss porque el
# razonamiento se come el presupuesto. 1500 es el minimo comodo.
STATS_AI_API_KEY=opcional_otra_cuenta
STATS_AI_MODEL=openai/gpt-oss-20b
STATS_AI_FALLBACK=openai/gpt-oss-120b
STATS_AI_MAX_TOKENS=1500

# Soporte: modelo APARTE para el chat de soporte (ai/soporte.py).
# No comparte modelos con las IAs principales. SUPPORT_AI_API_KEY es
# opcional (si falta, usa la key de 36AI con un modelo distinto).
SUPPORT_AI_API_KEY=opcional_otra_cuenta
SUPPORT_AI_MODEL=qwen/qwen3.6-27b

# Secret para firmar el token de /chat. En multi-instancia (Northflank) es
# OBLIGATORIO: sin el, cada reinicio genera un secret distinto y los tokens
# del navegador dejan de validar (403). Cualquier string largo sirve.
CHAT_CONV_SECRET=cambia_esto_por_un_string_largo_y_aleatorio

# Segunda fuente de stats de partido (corners, tarjetas, faltas).
# FotMob cubre ~75%; esta cubre parte del hueco. Solo se consulta cuando
# FotMob falla, asi que con el plan gratis (100 req/dia) sobra.
# Registro gratis: https://www.api-football.com/
API_FOOTBALL_KEY=
